  "settings": {
    "minimum_score_threshold": 0.4,
    "ambiguous_threshold": 0.2,
    "enable_fuzzy_matching": true,
    "case_sensitive": false,
    "enable_chinese_processing": false,
    "max_categories_per_folder": 3,
    "conflict_resolution": "highest_score",
    "enable_regex_patterns": false,
    "unicode_normalization": "NFC"
  },
  "text_processing": {
    "normalize_case": true,
    "remove_special_chars": true,
    "convert_underscores": true,
    "split_camel_case": true,
    "remove_numbers": false,
    "min_word_length": 2,
    "stop_words": ["the", "and", "or", "but", "in", "on", "at", "to", "for", "of", "with", "by"]
  },
  "advanced_features": {
    "learning_mode": {
      "enabled": false,
      "confidence_improvement_target": 0.1,
      "decision_history_file": "classification_decisions.json",
      "auto_update_rules": false
    },
    "performance_optimization": {
      "cache_compiled_patterns": true,
      "parallel_processing": true,
      "batch_size_optimization": true,
      "memory_efficient_mode": false
    },
    "validation": {
      "validate_target_directories": true,
      "check_write_permissions": true,
      "verify_disk_space": true,
      "prevent_system_directories": true
